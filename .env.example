# انسخ هذا الملف باسم .env وعبّي القيم
STORE_SECRET_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4500/auth/discord/callback
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
DISCORD_BOT_TOKEN=

# ---- اختياري: أمان وحماية ----
SITE_URL=https://your-domain.com
NODE_ENV=production
TRUST_PROXY=1
# حصر لوحة التحكم بعناوين IP معيّنة (مفصولة بفاصلة)
ADMIN_ALLOWED_IPS=
# اجبار كل الأدمنز على تفعيل التحقق بخطوتين
ADMIN_REQUIRE_2FA=0
# منع الحسابات الأحدث من X يوم من الشراء (0 = معطّل)
MIN_DISCORD_ACCOUNT_DAYS=0
# الطلبات بهذا المبلغ فما فوق تنتظر مراجعتك قبل تسليم الأكواد (0 = معطّل)
REVIEW_THRESHOLD_USD=0
MAX_PENDING_ORDERS=3
# النسخ الاحتياطي
BACKUP_KEEP=14
# تذكير السلات المتروكة عبر ديسكورد (يحتاج DISCORD_BOT_TOKEN)
ABANDONED_REMINDER=1
# انشر 4 منتجات تجريبية حتى بالإنتاج (للتجربة فقط)
SEED_DEMO=0

# مفتاح تشفير الأكواد (موصى به): أي نص عشوائي طويل. احتفظ بنسخة منه بمكان آمن!
# إذا تركته فاضي يُنشأ ملف codes.key بجانب القاعدة تلقائياً.
CODES_KEY=
# كابتشا Cloudflare Turnstile لتسجيل دخول الإدارة (اختياري)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
